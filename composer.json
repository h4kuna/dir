{
  "name": "h4kuna/dir",
  "description": "Create easily directories",
  "license": "MIT",
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "nette/utils": "^2.2 || ^3.0 || ^4.0"
  },
  "require-dev": {
    "nette/tester": "^2.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "shipmonk/coding-standard": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\Dir\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\Dir\\Tests\\": "tests/src"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "cbf": "vendor/bin/phpcbf",
    "coverage": "vendor/bin/tester --coverage coverage.html --coverage-src src/ --colors 1 -s -C tests/src/Unit",
    "cs": "vendor/bin/phpcs",
    "qa": [
      "@tests",
      "@cs",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/tester --colors 1 -s -C tests/src/Unit"
  }
}
